@startuml
' EXPERIMENT G ONLY — based on experiment A; .collab is authoritative.
' TickShip/TickMissile/TickTunnel are graphical aliases for ONE logical TickTimer.
title Fly N Shoot — timer legend and local signals (experiment G)
skinparam linetype polyline
skinparam shadowing false
top to bottom direction
skinparam usecase {
  BackgroundColor White
  BorderColor #666666
}
actor "Player" as Player
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickShip
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickMissile
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickTunnel
usecase "<b>T</b>\n<size:9>BlinkTimer:</size>" as BlinkTimer
usecase "<b>T</b>\n<size:9>ScreenTimer:</size>" as ScreenTimer
component "<size:17><b>Ship</b></size>" as Ship <<AO>>
component "<size:17><b>Missile</b></size>" as Missile <<AO>>
component "<size:17><b>Tunnel</b></size>" as Tunnel <<AO>>
component "Mine" as Mine <<HSM>>

' Single source of timer details, outside the relationship drawing.
legend bottom
  |= Timer |= Behaviour |= Signal posted |
  | <b>T</b> TickTimer | repeat; 30ms | TIME_TICK |
  | <b>T</b> BlinkTimer | one-shot; 5s | BLINK_TIMEOUT |
  | <b>T</b> ScreenTimer | one-shot; 5s | SCREEN_TIMEOUT |
endlegend

' Unlabelled timer arrows: timer-to-signal mapping lives in the legend.
TickShip -right-> Ship
TickMissile -right-> Missile
TickTunnel -right-> Tunnel
BlinkTimer -right-> Tunnel
ScreenTimer -right-> Tunnel

' Experiment G: receiver-headed two-column tables for bidirectional links.\n' Unidirectional links show signal names only.
Player --> Tunnel
note on link
  PLAYER_TRIGGER
  PLAYER_QUIT
end note
Player --> Ship
note on link
  PLAYER_SHIP_MOVE
  PLAYER_TRIGGER
end note
Ship <--> Missile
note on link
  |= -> Missile |= -> Ship |\n  | MISSILE_FIRE | DESTROYED_MINE |
end note
Ship <--> Tunnel
note on link
  |= -> Tunnel |= -> Ship |\n  | SHIP_IMG | HIT_WALL |\n  | SCORE | TAKE_OFF |\n  | EXPLOSION | |\n  | GAME_OVER | |
end note
Missile --> Tunnel
note on link
  MISSILE_IMG
  EXPLOSION
end note
Tunnel <--> Mine
note on link
  |= -> Mine |= -> Tunnel |\n  | TIME_TICK | MINE_IMG |\n  | SHIP_IMG | MINE_DISABLED |\n  | MISSILE_IMG | EXPLOSION |\n  | MINE_PLANT | |\n  | MINE_RECYCLE | |
end note
Mine --> Missile
note on link
  HIT_MINE
end note
Mine --> Ship
note on link
  HIT_MINE
end note
@enduml

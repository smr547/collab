@startuml
' EXPERIMENT ONLY: derived from examples/flyNshoot.puml at b1577db
' Visual aliases TickShip, TickMissile, TickTunnel denote the SAME logical TickTimer.
' Do not use this file as semantic evidence; the .collab source is authoritative.
title Fly N Shoot — local timer symbols (experiment A)
skinparam linetype polyline
skinparam shadowing false
top to bottom direction
skinparam usecase {
  BackgroundColor White
  BorderColor #666666
}
actor "Player" as Player
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickShip
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickMissile
usecase "<b>T</b>\n<size:9>TickTimer:</size>" as TickTunnel
usecase "<b>T</b>\n<size:9>BlinkTimer:</size>" as BlinkTimer
usecase "<b>T</b>\n<size:9>ScreenTimer:</size>" as ScreenTimer
component "<size:17><b>Ship</b></size>" as Ship <<AO>>
component "<size:17><b>Missile</b></size>" as Missile <<AO>>
component "<size:17><b>Tunnel</b></size>" as Tunnel <<AO>>
component "Mine" as Mine <<HSM>>
' Timer notes reduced to small annotations
note left of BlinkTimer : one-shot; 5s
note left of ScreenTimer : one-shot; 5s
note left of TickShip : repeat; 30ms

BlinkTimer --> Tunnel
note on link
  BlinkTimer -> Tunnel
    BLINK_TIMEOUT
end note
ScreenTimer --> Tunnel
note on link
  ScreenTimer -> Tunnel
    SCREEN_TIMEOUT
end note
Player --> Tunnel
note on link
  Player -> Tunnel
    PLAYER_TRIGGER
    PLAYER_QUIT
end note
Player --> Ship
note on link
  Player -> Ship
    PLAYER_SHIP_MOVE
    PLAYER_TRIGGER
end note
TickShip --> Ship
note on link
  TickTimer -> Ship
    TIME_TICK
end note
TickMissile --> Missile
note on link
  TickTimer -> Missile
    TIME_TICK
end note
TickTunnel --> Tunnel
note on link
  TickTimer -> Tunnel
    TIME_TICK
end note
Ship <--> Missile
note on link
  Ship -> Missile
    MISSILE_FIRE

  Missile -> Ship
    DESTROYED_MINE
end note
Ship <--> Tunnel
note on link
  Ship -> Tunnel
    SHIP_IMG
    SCORE
    EXPLOSION
    GAME_OVER

  Tunnel -> Ship
    HIT_WALL
    TAKE_OFF
end note
Missile --> Tunnel
note on link
  Missile -> Tunnel
    MISSILE_IMG
    EXPLOSION
end note
Tunnel <--> Mine
note on link
  Tunnel -> Mine
    TIME_TICK
    SHIP_IMG
    MISSILE_IMG
    MINE_PLANT
    MINE_RECYCLE

  Mine -> Tunnel
    MINE_IMG
    MINE_DISABLED
    EXPLOSION
end note
Mine --> Missile
note on link
  Mine -> Missile
    HIT_MINE
end note
Mine --> Ship
note on link
  Mine -> Ship
    HIT_MINE
end note
@enduml
